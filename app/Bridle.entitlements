<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (release.sh) blocks microphone capture unless this is granted.
	     Aria's Talk button and the Quick Assistant record audio in the app process. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
